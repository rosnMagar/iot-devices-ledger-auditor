# Copy this file to .env and adjust as needed for local development.
# docker-compose.yml reads these values.

# Which image tag to pull from GHCR. Deliberately left blank: docker compose
# fails with a clear message rather than defaulting, because a silent default
# meant a production box could pull :dev images and look perfectly healthy.
#   dev  — local development and the dev box
#   prod — the EC2 production box (see docs/deployment.md)
TAG=

# storage-core
LOG_LEVEL=info
LEDGER_PATH=/app/data/ledger.log
BIND_ADDR=0.0.0.0:8080

# backend-api
STORAGE_CORE_URL=http://storage-core:8080
DATABASE_URL=sqlite:////app/data/app.db
CORS_ORIGINS=http://localhost:5173

# frontend (baked at build time by Vite)
VITE_API_BASE_URL=http://localhost:8000
